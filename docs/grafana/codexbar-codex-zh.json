    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "每个节点占一行，显示当前可用的 Codex 限流重置卡数量和所有可用卡中最早的到期时间。张数 -1 表示 PAT 模式、接口不支持或查询失败；没有可用卡或接口未提供有效期时显示“未提供”。该接口结果缓存 10 分钟。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "可用张数"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "-1": {
                        "color": "orange",
                        "text": "无法获取"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "最近到期"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "orange",
                        "text": "未提供"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "id": 17,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (instance) (codexbar_reset_credits_available{job=~\"${job:regex}\",instance=~\"${instance:regex}\",provider=\"codex\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "可用张数",
          "range": false,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "(max by (instance) (codexbar_reset_credits_next_expiry_timestamp_seconds{job=~\"${job:regex}\",instance=~\"${instance:regex}\",provider=\"codex\"}) * 1000) or on(instance) (max by (instance) (codexbar_reset_credits_available{job=~\"${job:regex}\",instance=~\"${instance:regex}\",provider=\"codex\"}) * 0)",
          "format": "table",
          "instant": true,
          "legendFormat": "最近到期",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Codex 重置卡",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time #A": true,
              "Time #B": true,
              "__name__": true,
              "job": true,
              "monitor": true,
              "provider": true
            },
            "indexByName": {
              "instance": 0,
              "Value #A": 1,
              "Value #B": 2
            },
            "renameByName": {
              "Value #A": "可用张数",
              "Value #B": "最近到期",
              "instance": "节点"
            }
          }
        }
      ],
      "type": "table"
    },
